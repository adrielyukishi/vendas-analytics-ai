import React, { useMemo, useState } from "react";
import {
  Area, AreaChart, Bar, BarChart, CartesianGrid,
  ResponsiveContainer, Tooltip, XAxis, YAxis,
} from "recharts";

/* ============================ 1. TIPOS ============================ */
type View = "dashboard" | "estoque" | "marketplaces";
type Period = 7 | 30 | 90;
type StockStatus = "critico" | "atencao" | "saudavel";

interface DailySale { date: string; revenue: number; orders: number; cost: number }
interface Product { id: string; name: string; sku: string; stock: number; avgDailySales: number; unitCost: number }
interface Marketplace { name: string; revenue: number; connected: boolean; mode: "API" | "CSV" }
interface Kpi { label: string; value: string; hint: string }

/* ======================= 2. DADOS SIMULADOS ======================= */
const generateSales = (days: number): DailySale[] =>
  Array.from({ length: days }, (_, i) => {
    const d = new Date();
    d.setDate(d.getDate() - (days - 1 - i));
    const orders = 6 + Math.round(5 * Math.sin(i / 3) + (i % 5));
    const revenue = orders * (180 + (i % 7) * 12);
    return { date: d.toISOString().slice(0, 10), revenue, orders, cost: revenue * 0.62 };
  });

const SALES: DailySale[] = generateSales(90);

const PRODUCTS: Product[] = [
  { id: "p1", name: "Camiseta básica algodão", sku: "CAM-001", stock: 12, avgDailySales: 1.8, unitCost: 22 },
  { id: "p2", name: "Caneca personalizada", sku: "CAN-014", stock: 95, avgDailySales: 1.1, unitCost: 9 },
  { id: "p3", name: "Fone Bluetooth", sku: "FON-210", stock: 34, avgDailySales: 2.4, unitCost: 48 },
  { id: "p4", name: "Capa de celular", sku: "CAP-077", stock: 210, avgDailySales: 3.2, unitCost: 6 },
  { id: "p5", name: "Mochila urbana", sku: "MOC-033", stock: 7, avgDailySales: 0.9, unitCost: 71 },
  { id: "p6", name: "Garrafa térmica", sku: "GAR-120", stock: 58, avgDailySales: 1.5, unitCost: 30 },
];

const MARKETPLACES: Marketplace[] = [
  { name: "Mercado Livre", revenue: 48200, connected: true, mode: "API" },
  { name: "Shopee", revenue: 21300, connected: true, mode: "API" },
  { name: "Amazon", revenue: 0, connected: false, mode: "API" },
  { name: "Magazine Luiza", revenue: 9400, connected: true, mode: "CSV" },
];

/* ========================== 3. SERVIÇOS =========================== */
const brl = (v: number) => v.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
const pct = (v: number) => `${v.toFixed(1)}%`;

const filterByPeriod = (sales: DailySale[], period: Period) => sales.slice(-period);

function computeKpis(sales: DailySale[]): Kpi[] {
  const revenue = sales.reduce((s, d) => s + d.revenue, 0);
  const cost = sales.reduce((s, d) => s + d.cost, 0);
  const orders = sales.reduce((s, d) => s + d.orders, 0);
  const profit = revenue - cost;
  return [
    { label: "Receita bruta", value: brl(revenue), hint: "Soma das vendas no período" },
    { label: "Lucro estimado", value: brl(profit), hint: "Receita menos custo dos produtos" },
    { label: "Margem média", value: pct(revenue ? (profit / revenue) * 100 : 0), hint: "Lucro ÷ receita" },
    { label: "Pedidos", value: String(orders), hint: `Ticket médio ${brl(orders ? revenue / orders : 0)}` },
  ];
}

function stockStatus(p: Product): { status: StockStatus; daysLeft: number } {
  const daysLeft = p.avgDailySales ? Math.floor(p.stock / p.avgDailySales) : Infinity;
  const status: StockStatus = daysLeft <= 10 ? "critico" : daysLeft <= 30 ? "atencao" : "saudavel";
  return { status, daysLeft };
}

const STATUS_LABEL: Record<StockStatus, string> = {
  critico: "Repor agora", atencao: "Repor em breve", saudavel: "Estoque saudável",
};

/* ========================= 4. COMPONENTES ========================= */
const KpiCard: React.FC<{ kpi: Kpi }> = ({ kpi }) => (
  <article className="card kpi">
    <span className="muted">{kpi.label}</span>
    <strong className="kpi-value">{kpi.value}</strong>
    <small className="muted">{kpi.hint}</small>
  </article>
);

const SalesChart: React.FC<{ data: DailySale[] }> = ({ data }) => (
  <section className="card">
    <h3>Evolução das vendas</h3>
    <ResponsiveContainer width="100%" height={260}>
      <AreaChart data={data}>
        <defs>
          <linearGradient id="rev" x1="0" y1="0" x2="0" y2="1">
            <stop offset="5%" stopColor="#2a9d8f" stopOpacity={0.5} />
            <stop offset="95%" stopColor="#2a9d8f" stopOpacity={0} />
          </linearGradient>
        </defs>
        <CartesianGrid strokeDasharray="3 3" stroke="#2b3340" />
        <XAxis dataKey="date" tickFormatter={(d: string) => d.slice(5)} stroke="#8b95a5" />
        <YAxis tickFormatter={(v: number) => `${v / 1000}k`} stroke="#8b95a5" />
        <Tooltip formatter={(v: number) => brl(v)} contentStyle={{ background: "#171c24", border: "1px solid #2b3340" }} />
        <Area type="monotone" dataKey="revenue" name="Receita" stroke="#2a9d8f" fill="url(#rev)" />
      </AreaChart>
    </ResponsiveContainer>
  </section>
);

const MarketplaceChart: React.FC<{ data: Marketplace[] }> = ({ data }) => (
  <section className="card">
    <h3>Vendas por marketplace</h3>
    <ResponsiveContainer width="100%" height={260}>
      <BarChart data={data} layout="vertical" margin={{ left: 30 }}>
        <CartesianGrid strokeDasharray="3 3" stroke="#2b3340" />
        <XAxis type="number" tickFormatter={(v: number) => `${v / 1000}k`} stroke="#8b95a5" />
        <YAxis type="category" dataKey="name" stroke="#8b95a5" width={110} />
        <Tooltip formatter={(v: number) => brl(v)} contentStyle={{ background: "#171c24", border: "1px solid #2b3340" }} />
        <Bar dataKey="revenue" name="Receita" fill="#e9c46a" radius={[0, 4, 4, 0]} />
      </BarChart>
    </ResponsiveContainer>
  </section>
);

const StockTable: React.FC<{ products: Product[] }> = ({ products }) => {
  const [query, setQuery] = useState("");
  const rows = useMemo(
    () => products
      .filter((p) => `${p.name} ${p.sku}`.toLowerCase().includes(query.toLowerCase()))
      .map((p) => ({ ...p, ...stockStatus(p) }))
      .sort((a, b) => a.daysLeft - b.daysLeft),
    [products, query],
  );

  return (
    <section className="card">
      <header className="row between">
        <h3>Estoque operacional</h3>
        <input
          className="search"
          placeholder="Buscar produto ou SKU"
          aria-label="Buscar produto ou SKU"
          value={query}
          onChange={(e) => setQuery(e.target.value)}
        />
      </header>
      <div className="scroll">
        <table>
          <thead>
            <tr><th>Produto</th><th>SKU</th><th>Estoque</th><th>Vendas/dia</th><th>Dura (dias)</th><th>Situação</th></tr>
          </thead>
          <tbody>
            {rows.length === 0 && <tr><td colSpan={6} className="muted">Nenhum produto encontrado.</td></tr>}
            {rows.map((p) => (
              <tr key={p.id}>
                <td>{p.name}</td><td className="muted">{p.sku}</td>
                <td>{p.stock}</td><td>{p.avgDailySales.toFixed(1)}</td>
                <td>{p.daysLeft}</td>
                <td><span className={`badge ${p.status}`}>{STATUS_LABEL[p.status]}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  );
};

const MarketplaceList: React.FC<{ data: Marketplace[] }> = ({ data }) => (
  <section className="card">
    <h3>Contas conectadas</h3>
    <ul className="list">
      {data.map((m) => (
        <li key={m.name} className="row between">
          <div>
            <strong>{m.name}</strong>
            <div className="muted small">{m.mode === "API" ? "Integração por API" : "Importação de planilha CSV"}</div>
          </div>
          <button className="btn" disabled={m.connected}>{m.connected ? "Conectado" : "Conectar"}</button>
        </li>
      ))}
    </ul>
  </section>
);

const NAV: { id: View; label: string }[] = [
  { id: "dashboard", label: "Visão geral" },
  { id: "estoque", label: "Estoque" },
  { id: "marketplaces", label: "Marketplaces" },
];

const Sidebar: React.FC<{ view: View; onChange: (v: View) => void }> = ({ view, onChange }) => (
  <aside className="sidebar">
    <h1 className="brand">Advance Analytics</h1>
    <nav>
      {NAV.map((item) => (
        <button key={item.id} className={`nav ${view === item.id ? "active" : ""}`} onClick={() => onChange(item.id)}>
          {item.label}
        </button>
      ))}
    </nav>
    <p className="muted small">Dados fictícios para demonstração.</p>
  </aside>
);

/* ============================ 5. APP ============================== */
export default function App() {
  const [view, setView] = useState<View>("dashboard");
  const [period, setPeriod] = useState<Period>(30);

  const sales = useMemo(() => filterByPeriod(SALES, period), [period]);
  const kpis = useMemo(() => computeKpis(sales), [sales]);

  return (
    <div className="layout">
      <style>{CSS}</style>
      <Sidebar view={view} onChange={setView} />

      <main className="content">
        <header className="row between">
          <h2>{NAV.find((n) => n.id === view)?.label}</h2>
          {view === "dashboard" && (
            <div className="row" role="group" aria-label="Período">
              {([7, 30, 90] as Period[]).map((p) => (
                <button key={p} className={`chip ${period === p ? "active" : ""}`} onClick={() => setPeriod(p)}>
                  {p} dias
                </button>
              ))}
            </div>
          )}
        </header>

        {view === "dashboard" && (
          <>
            <div className="grid kpis">{kpis.map((k) => <KpiCard key={k.label} kpi={k} />)}</div>
            <div className="grid two">
              <SalesChart data={sales} />
              <MarketplaceChart data={MARKETPLACES} />
            </div>
            <StockTable products={PRODUCTS.slice(0, 4)} />
          </>
        )}
        {view === "estoque" && <StockTable products={PRODUCTS} />}
        {view === "marketplaces" && (
          <div className="grid two">
            <MarketplaceList data={MARKETPLACES} />
            <MarketplaceChart data={MARKETPLACES} />
          </div>
        )}
      </main>
    </div>
  );
}

